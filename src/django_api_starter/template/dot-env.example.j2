# Copy to .env and adjust. Never commit .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

{% if database == "postgres" %}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ slug }}
{% else %}
# Defaults to db.sqlite3 in the project root.
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
{% endif %}
{% if celery %}

# Redis: cache and Celery broker/results
REDIS_URL=redis://localhost:6379/0
{% endif %}

# Comma-separated origins allowed to call the API from a browser (production).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Email (development prints emails to the console by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL={{ name }} <noreply@example.com>

# Frontend page that handles password resets; {uid} and {token} are filled in.
PASSWORD_RESET_URL=http://localhost:3000/reset-password?uid={uid}&token={token}
{% if two_factor %}

# One-time passwords
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
{% endif %}
