class VerifyOTPSerializer(serializers.Serializer):
    verification_id = serializers.UUIDField()
    code = serializers.CharField(max_length=12)

    def validate(self, attrs):
        otp = (
            OTP.objects.select_related("user")
            .filter(pk=attrs["verification_id"], used_at__isnull=True, user__is_active=True)
            .first()
        )
        if otp is None:
            raise serializers.ValidationError("This verification is invalid or was already used.")
        if otp.is_expired:
            raise serializers.ValidationError("This code has expired. Request a new one.", code="otp_expired")
        if otp.attempts_exhausted:
            raise serializers.ValidationError("Too many incorrect attempts. Request a new code.", code="otp_locked")
        if not otp.check_code(attrs["code"]):
            raise serializers.ValidationError({"code": "Incorrect code."})
        attrs["otp"] = otp
        return attrs


