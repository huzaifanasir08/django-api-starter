{% if celery %}
from django.core.cache import cache
{% endif %}
from django.db import connection
from rest_framework import status
from rest_framework.permissions import AllowAny
from rest_framework.response import Response
from rest_framework.views import APIView


class HealthCheckView(APIView):
{% if celery %}
    """Liveness/readiness probe: returns 200 when the database and Redis are reachable."""
{% else %}
    """Liveness/readiness probe: returns 200 when the database is reachable."""
{% endif %}

    authentication_classes = []
    permission_classes = [AllowAny]
    schema = None  # infrastructure endpoint, not part of the public API docs

    def get(self, request):
        checks = {"database": _check(connection.ensure_connection)}
{% if celery %}
        checks["cache"] = _check(lambda: cache.set("health-check", "ok", timeout=5))
{% endif %}
        healthy = all(result == "ok" for result in checks.values())
        return Response(
            {"status": "ok" if healthy else "error", **checks},
            status=status.HTTP_200_OK if healthy else status.HTTP_503_SERVICE_UNAVAILABLE,
        )


def _check(probe):
    try:
        probe()
    except Exception:
        return "unavailable"
    return "ok"
