import uuid

REQUEST_ID_HEADER = "X-Request-ID"


class RequestIDMiddleware:
    """Attach a request ID to every request and response for tracing.

    Reuses the incoming ``X-Request-ID`` header (e.g. set by a load balancer)
    or generates one, exposes it as ``request.request_id`` and echoes it back.
    """

    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        request_id = request.headers.get(REQUEST_ID_HEADER, "")[:64] or uuid.uuid4().hex
        request.request_id = request_id
        response = self.get_response(request)
        response[REQUEST_ID_HEADER] = request_id
        return response
