import re

import pytest
from django.core import mail
from django.urls import reverse

from core.factories import UserFactory

pytestmark = pytest.mark.django_db

NEW_PASSWORD = "An0ther-Str0ng-pass"


def test_change_password(auth_client, password):
    response = auth_client.post(
        reverse("accounts:password-change"),
        {"current_password": password, "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )

    assert response.status_code == 200
    assert "tokens" in response.data
    auth_client.user.refresh_from_db()
    assert auth_client.user.check_password(NEW_PASSWORD)


def test_change_password_revokes_existing_refresh_tokens(api_client, user, password):
    tokens = api_client.post(reverse("accounts:login"), {"email": user.email, "password": password}).data["tokens"]
    api_client.credentials(HTTP_AUTHORIZATION=f"Bearer {tokens['access']}")

    api_client.post(
        reverse("accounts:password-change"),
        {"current_password": password, "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )

    response = api_client.post(reverse("accounts:token-refresh"), {"refresh": tokens["refresh"]})
    assert response.status_code == 401


def test_change_password_requires_current_password(auth_client):
    response = auth_client.post(
        reverse("accounts:password-change"),
        {"current_password": "wrong", "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )

    assert response.status_code == 400
    assert "current_password" in response.data["errors"]


def request_reset(api_client, email):
    response = api_client.post(reverse("accounts:password-reset"), {"email": email})
    assert response.status_code == 200
    return response


def test_password_reset_flow(api_client, user):
    request_reset(api_client, user.email)

    assert len(mail.outbox) == 1
    uid, token = re.search(r"uid=([\w-]+)&(?:amp;)?token=([\w-]+)", mail.outbox[0].body).groups()

    response = api_client.post(
        reverse("accounts:password-reset-confirm"),
        {"uid": uid, "token": token, "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )
    assert response.status_code == 200
    user.refresh_from_db()
    assert user.check_password(NEW_PASSWORD)

    # The link is single-use: the token is tied to the old password hash.
    reused = api_client.post(
        reverse("accounts:password-reset-confirm"),
        {"uid": uid, "token": token, "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )
    assert reused.status_code == 400


def test_password_reset_does_not_reveal_unknown_email(api_client):
    response = request_reset(api_client, "nobody@example.com")

    assert "If an account exists" in response.data["message"]
    assert len(mail.outbox) == 0


def test_password_reset_ignores_inactive_user(api_client):
    user = UserFactory(is_active=False)

    request_reset(api_client, user.email)

    assert len(mail.outbox) == 0


def test_password_reset_confirm_rejects_bad_token(api_client, user):
    response = api_client.post(
        reverse("accounts:password-reset-confirm"),
        {"uid": "MQ", "token": "bad-token", "new_password": NEW_PASSWORD, "new_password_confirm": NEW_PASSWORD},
    )

    assert response.status_code == 400
